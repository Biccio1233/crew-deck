{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Crew Deck",
  "version": "0.5.0",
  "identifier": "dev.crewdeck.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Crew Deck",
        "width": 1000,
        "height": 760
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "La plancia dell'equipaggio dei tuoi agenti AI",
    "category": "DeveloperTool",
    "copyright": "\u00a9 2026 Crew Deck contributors \u00b7 MIT"
  }
}
